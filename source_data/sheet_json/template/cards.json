{
  "flow_type": "template",
  "flow_name": "cards",
  "status": "released",
  "rows": [
    {
      "name": "favourite_image_asset",
      "value": "images/fine_heart.svg"
    },
    {
      "name": "favourite_checked_image_asset",
      "value": "images/full_heart.svg"
    },
    {
      "name": "at_least_one_favourite",
      "value": false
    },
    {
      "type": "begin_items",
      "value": "@data.cards"
    },
    {
      "name": "at_least_one_favourite",
      "value": true,
      "condition": "@fields.@item.favourite_field"
    },
    {
      "type": "end_items"
    },
    {
      "type": "begin_display_group",
      "name": "dg_top"
    },
    {
      "name": "now",
      "value": "@calc(timestamp())"
    },
    {
      "name": "click_history",
      "value": "_click_history"
    },
    {
      "name": "click_history_field_name",
      "value": "random_activity@local.click_history"
    },
    {
      "name": "click_history_value",
      "value": "@fields.@local.click_history_field_name ;  @local.now",
      "condition": "!!(@fields.@local.click_history_field_name)",
      "comments": true
    },
    {
      "name": "click_history_value",
      "value": "@local.now",
      "condition": "!(@fields.@local.click_history_field_name)"
    },
    {
      "type": "begin_items",
      "value": "@data.cards",
      "parameter_list": "shuffle;\nlimit: 1;"
    },
    {
      "type": "button",
      "name": "button_random",
      "value": "Give me a card",
      "action_list": "click | emit: force_reload;\nclick | go_to: card_page_@item.id;\nclick | set_field: @local.click_history_field_name: @local.click_history_value",
      "parameter_list": "style: navigation"
    },
    {
      "type": "end_items"
    },
    {
      "type": "button",
      "name": "button_favourites",
      "value": "My Favourite Cards",
      "action_list": "click | go_to: my_cards",
      "condition": "@local.at_least_one_favourite"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_items",
      "value": "@data.cards_group"
    },
    {
      "name": "group_id",
      "value": "@item.id"
    },
    {
      "type": "title",
      "name": "title_@item.id",
      "value": "@item.title"
    },
    {
      "type": "text",
      "name": "text_@item.id",
      "value": "@item.text"
    },
    {
      "type": "begin_carousel",
      "name": "carousel_@item.title",
      "parameter_list": "centred_slides: false;\nspace_between: 0;"
    },
    {
      "type": "begin_items",
      "value": "@data.cards"
    },
    {
      "type": "begin_template",
      "name": "card_button_@item.id",
      "value": "card_button",
      "condition": "@item.group == @local.group_id"
    },
    {
      "name": "card_id",
      "value": "@item.id"
    },
    {
      "name": "card_no",
      "value": "@item.card_no"
    },
    {
      "type": "end_template"
    },
    {
      "type": "end_items"
    },
    {
      "type": "end_carousel"
    },
    {
      "type": "end_items"
    }
  ]
}